# ---- credentials: never versioned -----------------------------------------
agent.env
ui-token.txt
cookies.txt
bootstrap.json
federation/identity.json
keys/
.keys/
secrets/
*.key
*.pem
*.p12
*.pfx

# ---- per-expert state and memory ------------------------------------------
# The CODE is versioned; the MINDS are not. An expert's world is its own
# history — back it up with backup.py, which excludes credentials properly.
experts/
!experts/.gitkeep
retired/
teamwork/
demo-run*/
backups/
!backups/.gitkeep
commons/
!commons/.gitkeep

# ---- generated at runtime --------------------------------------------------
logs/
!logs/.gitkeep
contexts/
!contexts/.gitkeep
checkpoints/
events/
approvals/
consults/
goals/
inbox/
!inbox/.gitkeep
state.json
state.json.corrupt-*
spend-*.json
briefing.md
commons-digest.md

# ---- python / os -----------------------------------------------------------
__pycache__/
*.pyc
*.tmp
tests/tmp/
.DS_Store
.firecrawl/

# Worker deps (deploy/worker) — restored with `npm install`
node_modules/
.wrangler/

# A GIT CLONE DOES NOT CREATE EMPTY DIRECTORIES, and the installer's own
# final instruction is "Drop material into inbox/". A fresh clone landed
# without inbox, experts, logs, contexts, commons, backups, org and
# federation, so the first thing an owner is told to do failed. package.py
# already ships EMPTY_DIRS in the zip; only the clone path was bare. The
# negations above keep one marker file per directory so every install
# route lands the same tree.

# ---- suite run artifacts ---------------------------------------------------
# ~700 KB per run and regenerated by `python tests/run_all.py`. The VERDICT
# belongs in the changelog and in EVIDENCE.md; the transcript does not belong
# in history.
full-suite-*.log
baseline-suite.log

# Focused-run transcripts: machine paths, and they capture a MOMENT (one of
# them ends in a failure that has since been fixed). A receipt that shows a
# stale red run reads as evidence and is not. The verdicts live in
# CHANGELOG.md and EVIDENCE.md, which are regenerated from the suite.
docs/implementation-receipts/

# mutate_check.py edits tracked source IN PLACE and restores it, leaving a
# backup beside each file. A crashed or interrupted run therefore leaves a
# .mutbak in the tree, and `git add -A` would publish it — or worse, publish
# the file it was taken from while still mutated. Never versioned.
*.mutbak

# proof.py --refresh transcript: a run artifact, like the suite logs
proof-refresh.log
