# Copy this file to agent.env (same folder) and fill in your keys, or let
# `python bootstrap.py --key NAME=VALUE` write them for you (it never prints
# a value). loop.py and ingest.py load this file automatically on any OS.
# SET SPEND CAPS AT EVERY PROVIDER BEFORE FIRST USE.

# --- model providers (any OpenAI-compatible endpoint works) ---
# Fill ANY ONE of these and point roles at it in settings.toml — the
# platform is provider-universal: official APIs, aggregators, edge, local.
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=
# ANTHROPIC_API_KEY=          # official Claude API (OpenAI-compat layer)
# GEMINI_API_KEY=             # official Google Gemini (free flash quota)
# XAI_API_KEY=                # official xAI Grok
# CLOUDFLARE_API_TOKEN=       # Workers AI (10k free Neurons/day)
# OLLAMA_API_KEY=local        # local models: value never checked

# --- optional: hosted sandboxes for [agent] sandbox = "e2b" | "daytona" ---
# E2B_API_KEY=
# DAYTONA_API_KEY=

# --- optional: guard the control panel when it listens beyond localhost ---
# UI_TOKEN=
